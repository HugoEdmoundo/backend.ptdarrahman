{
  "name": "backend-ptdarrahman",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "node api/index.js",
    "build": "npx esbuild ./src/vercel.ts --bundle --platform=node --target=node22 --outfile=api/index.js --packages=external --format=esm && mkdir -p public && echo 'API Ready' > public/index.html",
    "deploy:cf": "wrangler deploy",
    "seed": "bun run src/seed.ts",
    "lint": "eslint src/ api/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "mysql2": "^3.22.5",
    "openapi3-ts": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "resend": "^6.17.2",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "@esbuild/linux-x64": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.6.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.1",
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
